spring:
  datasource:
    url: jdbc:mysql://localhost:3306/aiscanner?useUnicode=true&characterEncoding=utf8mb4&serverTimezone=Asia/Shanghai
    username: root
    password: your_password_here

  data:
    redis:
      host: localhost
      port: 6379
      password: your_redis_password_here

ai:
  service:
    url: http://localhost:8000

logging:
  level:
    org.example.aiscanner_server: DEBUG
    org.example.aiscanner_server.mapper: DEBUG
